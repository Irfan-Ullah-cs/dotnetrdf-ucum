<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DotNetRdf.Ucum</RootNamespace>
    <AssemblyName>DotNetRdf.Ucum</AssemblyName>

    <Version>0.1.0</Version>
    <PackageId>DotNetRdf.Ucum</PackageId>
    <Authors>Irfan Ullah</Authors>
    <Description>CDT (Custom Datatypes) UCUM extension for dotNetRDF, implementing cdt:ucum and cdt:ucumunit with unit-aware SPARQL arithmetic, comparison, and cdt:sameDimension.</Description>
    <RepositoryUrl>https://github.com/Irfan-Ullah-cs/dotnetrdf-ucum</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="dotNetRdf.Core" Version="3.5.1" />
    <PackageReference Include="Fhir.Metrics" Version="1.3.1" />
  </ItemGroup>

</Project>